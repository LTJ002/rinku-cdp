# Build output
build/
dist/
out/
*.class

# Logs
*.log
logs/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
Thumbs.db
.DS_Store
desktop.ini

# Test media (too large for git)
*.mp4
*.mkv
*.avi
*.zip
*.7z

# Third-party jars the user downloads themselves
libs/*.jar
!libs/.gitkeep

# Local machine config
cp-local.txt
game-jvm.txt
game-args.txt

# Release jars ARE tracked - they are the deliverable.
# Do not add *.jar here, and keep releases/ out of the ignore list.
!releases/*.jar
